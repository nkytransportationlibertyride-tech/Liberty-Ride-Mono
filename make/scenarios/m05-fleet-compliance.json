{
 "modules": [
  {
   "config": {
    "mapper": {
     "method": "GET",
     "qs": [
      {
       "key": "select",
       "value": "vehicle_id,mileage,next_oil_change_miles,insurance_expiry_date,cvg_permit_status,created_at"
      },
      {
       "key": "order",
       "value": "created_at.desc"
      },
      {
       "key": "limit",
       "value": "200"
      }
     ],
     "url": "/rest/v1/fleet_logs"
    },
    "parameters": {
     "__IMTCONN__": 12014112
    }
   },
   "id": 1,
   "label": "Recent fleet readings (REST)",
   "module": "supabase:makeAnApiCall",
   "version": 1,
   "root": "main"
  },
  {
   "config": {
    "mapper": {
     "array": "{{1.body}}"
    }
   },
   "follows": 1,
   "id": 2,
   "label": "Each fleet row",
   "module": "builtin:BasicFeeder",
   "version": 1
  },
  {
   "config": {
    "flags": {
     "groupBy": "{{2.vehicle_id}}",
     "stopIfEmpty": true
    },
    "mapper": {
     "created_at": "{{2.created_at}}",
     "cvg_permit_status": "{{2.cvg_permit_status}}",
     "insurance_expiry_date": "{{2.insurance_expiry_date}}",
     "mileage": "{{2.mileage}}",
     "next_oil_change_miles": "{{2.next_oil_change_miles}}",
     "vehicle_id": "{{2.vehicle_id}}"
    },
    "parameters": {
     "feeder": 2
    }
   },
   "follows": 2,
   "id": 3,
   "label": "Latest row per vehicle (groupBy)",
   "module": "builtin:BasicAggregator",
   "version": 1
  },
  {
   "config": {
    "mapper": {
     "name": "alerts",
     "scope": "execution",
     "value": "{{if(and(not(isEmpty(first(3.array).next_oil_change_miles)); first(3.array).mileage >= first(3.array).next_oil_change_miles - 500); \"🛢️ \" + first(3.array).vehicle_id + \" : vidange proche ou due (\" + first(3.array).mileage + \" miles, échéance \" + first(3.array).next_oil_change_miles + \").\\n\"; \"\") + if(and(not(isEmpty(first(3.array).insurance_expiry_date)); round((parseDate(first(3.array).insurance_expiry_date; \"YYYY-MM-DD\") - now) / 86400000) < 30); \"🛡️ \" + first(3.array).vehicle_id + \" : assurance expire dans \" + round((parseDate(first(3.array).insurance_expiry_date; \"YYYY-MM-DD\") - now) / 86400000) + \" jour(s) (\" + first(3.array).insurance_expiry_date + \").\\n\"; \"\") + if(and(not(isEmpty(first(3.array).cvg_permit_status)); or(isEmpty(match(first(3.array).cvg_permit_status; \"\\b(valid|valide|actif|active|approved|approuvé)\\b\")); not(isEmpty(match(first(3.array).cvg_permit_status; \"\\b(invalid|invalide|inactive|inactif|expired|expiré|expire|suspended|suspendu|revoked|révoqué)\\b\"))))); \"📋 \" + first(3.array).vehicle_id + \" : statut permis CVG à vérifier : \" + first(3.array).cvg_permit_status; \"\")}}"
    }
   },
   "follows": 3,
   "id": 4,
   "label": "Compute vehicle alerts (IML — VERIFY)",
   "module": "util:SetVariable2",
   "version": 1
  },
  {
   "config": {
    "mapper": {
     "value": "{{3.alerts}}"
    },
    "parameters": {
     "feeder": 4,
     "rowSeparator": "\n"
    }
   },
   "filter": {
    "conditions": [
     [
      {
       "a": "{{3.alerts}}",
       "b": "",
       "o": "text:notequal"
      }
     ]
    ],
    "name": "Skip vehicles with no alerts"
   },
   "follows": 4,
   "id": 5,
   "label": "Join alerts",
   "module": "util:TextAggregator",
   "version": 1
  },
  {
   "config": {
    "mapper": {
     "allowRedirects": true,
     "contentType": "json",
     "headers": [
      {
       "name": "Content-Type",
       "value": "application/json"
      }
     ],
     "inputMethod": "jsonString",
     "jsonStringBodyContent": "{\"text\": \"🚐 Contrôle flotte hebdomadaire :\\n{{5.text}}\"}",
     "method": "post",
     "parseResponse": true,
     "requestCompressedContent": true,
     "shareCookies": false,
     "stopOnHttpError": true,
     "url": "https://example.invalid/owner-notify"
    },
    "parameters": {
     "authenticationType": "noAuth"
    }
   },
   "filter": {
    "conditions": [
     [
      {
       "a": "{{5.text}}",
       "b": "",
       "o": "text:notequal"
      }
     ]
    ],
    "name": "At least one alert"
   },
   "follows": 5,
   "id": 6,
   "label": "Notify owner (CHANNEL TBD — NOT Telegram)",
   "module": "http:MakeRequest",
   "version": 4
  }
 ],
 "name": "M05 Fleet Compliance Weekly v1",
 "scheduling": {
  "type": "weekly",
  "time": "07:00",
  "days": [
   1
  ]
 },
 "teamId": 3285635
}